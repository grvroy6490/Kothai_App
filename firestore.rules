rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper function to validate user data structure
    function isValidUserData(data) {
      return data.keys().hasAll(['uid', 'email', 'updatedAt']) &&
             data.uid is string &&
             data.email is string;
    }
    
    // Helper function to validate score data structure
    function isValidScoreData(data) {
      return data.keys().hasAll(['totalXp', 'level']) &&
             data.totalXp is int &&
             data.level is int &&
             data.totalXp >= 0 &&
             data.level >= 1;
    }
    
    // Helper function to validate XP entry structure
    function isValidXPEntry(data) {
      return data.keys().hasAll(['id', 'at', 'mode', 'amount', 'synced']) &&
             data.id is string &&
             data.at is timestamp &&
             data.mode is string &&
             data.amount is int &&
             data.synced is bool &&
             data.amount >= 0;
    }
    
    // ============================================
    // USERS COLLECTION
    // ============================================
    match /users/{userId} {
      // Allow read if user is authenticated and owns the document
      allow read: if isOwner(userId);
      
      // Allow create if user is authenticated and creating their own document
      allow create: if isAuthenticated() &&
                      isOwner(userId) &&
                      isValidUserData(request.resource.data) &&
                      request.resource.data.uid == userId;
      
      // Allow update if user is authenticated and updating their own document
      // Only allow updating specific fields, not overwriting critical data
      allow update: if isAuthenticated() &&
                      isOwner(userId) &&
                      isValidUserData(request.resource.data) &&
                      request.resource.data.uid == userId &&
                      // Prevent changing uid
                      request.resource.data.uid == resource.data.uid &&
                      // Prevent changing email (should be done through Firebase Auth)
                      request.resource.data.email == resource.data.email;
      
      // Allow delete only by the user themselves (for account deletion)
      allow delete: if isOwner(userId);
      
      // ============================================
      // USER SCORE SUBCOLLECTION
      // ============================================
      match /score/{scoreId} {
        // Allow read if user owns the parent document
        allow read: if isOwner(userId);
        
        // Allow create/update if user owns the parent document
        allow create, update: if isAuthenticated() &&
                                isOwner(userId) &&
                                isValidScoreData(request.resource.data);
        
        // Allow delete if user owns the parent document
        allow delete: if isOwner(userId);
      }
      
      // ============================================
      // USER XP ENTRIES SUBCOLLECTION
      // ============================================
      match /xpEntries/{entryId} {
        // Allow read if user owns the parent document
        allow read: if isOwner(userId);
        
        // Allow create if user owns the parent document
        allow create: if isAuthenticated() &&
                        isOwner(userId) &&
                        isValidXPEntry(request.resource.data) &&
                        request.resource.data.id == entryId;
        
        // Allow update only to mark as synced (prevent tampering with XP amounts)
        allow update: if isAuthenticated() &&
                        isOwner(userId) &&
                        // Only allow updating the 'synced' field
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['synced']) &&
                        request.resource.data.synced is bool;
        
        // Allow delete if user owns the parent document
        allow delete: if isOwner(userId);
      }
      
      // ============================================
      // USER STATS SUBCOLLECTION
      // ============================================
      match /stats/{statId} {
        // Allow read if user owns the parent document
        allow read: if isOwner(userId);
        
        // Allow create/update if user owns the parent document
        allow create, update: if isAuthenticated() &&
                                isOwner(userId);
        
        // Allow delete if user owns the parent document
        allow delete: if isOwner(userId);
      }
      
      // ============================================
      // USER SESSIONS SUBCOLLECTION
      // ============================================
      match /sessions/{sessionId} {
        // Allow read if user owns the parent document
        allow read: if isOwner(userId);
        
        // Allow create/update if user owns the parent document
        allow create, update: if isAuthenticated() &&
                                isOwner(userId);
        
        // Allow delete if user owns the parent document
        allow delete: if isOwner(userId);
      }
    }
    
    // ============================================
    // DENY ALL OTHER ACCESS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
